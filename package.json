{
  "name": "open-beauty-site",
  "version": "0.1.0",
  "description": "A design harness + MCP server that lets small models make beautiful HTML pages and GIFs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "jdsalasca",
  "homepage": "https://github.com/jdsalasca/open-beauty-site",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdsalasca/open-beauty-site.git"
  },
  "keywords": [
    "mcp",
    "design-system",
    "html",
    "gif",
    "generative-design",
    "typography",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "beauty": "dist/cli.js",
    "open-beauty-site": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/*": "./dist/styles/*.js"
  },
  "files": [
    "dist",
    "skills",
    "fonts",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "pnpm install && pnpm build && pnpm test",
    "prepare": "tsx src/cli.ts --prepare",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:prod": "node dist/mcp/server.js",
    "mcp:config": "tsx scripts/mcp-config.ts",
    "test": "tsx --test test/*.test.ts",
    "examples": "tsx scripts/build-examples.ts",
    "education": "tsx scripts/build-education.ts",
    "showcase": "tsx scripts/build-showcase.ts",
    "compare": "tsx scripts/build-compare.ts",
    "coverage:matrix": "tsx scripts/coverage-matrix.ts",
    "visual:matrix": "tsx scripts/visual-matrix.ts",
    "fonts:check": "tsx scripts/narrative-fonts-check.ts",
    "docs:build": "tsx scripts/build-docs.ts",
    "e2e:colmena": "tsx scripts/e2e-colmena.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "check:all": "pnpm check && pnpm build && pnpm check:scripts && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.11",
    "gifenc": "^1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
